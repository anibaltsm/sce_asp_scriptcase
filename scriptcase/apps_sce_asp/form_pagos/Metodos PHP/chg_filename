// ---------------------------------------------------------------------------
// Método: chg_filename
// Descripción: Renombra el comprobante de pago y el CSF subidos, los copia a la
//   carpeta de aspirantes con nombre normalizado y actualiza ambos registros en BD.
// Requiere: cont_file y doc_compr_pago con valor para ejecutar el bloque de pago.
//           doc_csf con valor para ejecutar el bloque de CSF.
// Logs: ver README_LOGS.md en la raíz del proyecto.
// ---------------------------------------------------------------------------
// Origen de los datos (form abierto desde grid o enlace; tabla principal: sce.pagos):
// - referencia: campo de sce.pagos. Se genera al crear el pago (app_form_add_users o crea_referencia)
//   como "INECOLPA0002" + id_asp sin ceros + "00" → ej. INECOLPA0002127800 (id_asp 1278).
// - usr_login: variable de sesión (login del usuario que abre el form). Se usa solo para carpeta
//   aspirantes (destino) y para el UPDATE en asp_requisitos.
// - id_asp_FK: campo de sce.pagos (id del aspirante). La tabla NO tiene columna "Id".
//
// CARPETA PAGOS: el archivo subido (UUID) viene en sce_asp/_lib/file/doc/pagos/generacion/
//   pero su destino final es sce/_lib/file/doc/pagos/generacion/ (proyecto sce, donde lo sirve el grid).
// CARPETA ASPIRANTES (copia): aspirantes/generacion/usr_login/ en sce_asp — se mantiene por aspirante.
//
// BLOQUE 1 — COMPROBANTE DE PAGO:
//   Nombres: {referencia}_{prefijo_req}.{ext}  /  {generacion}_{id_asp}_{num_req}_{prefijo_req}.{ext}
//   Campo BD: sce.pagos.doc_compr_pago  |  sce_asp.asp_requisitos (cc_pago=1)
// BLOQUE 2 — CSF:
//   Nombres: {referencia}_csf.{ext}  /  {generacion}_{id_asp}_{num_req}_csf.{ext}
//   Campo BD: sce.pagos.doc_csf  |  sce_asp.asp_requisitos (prefijo_requisito='csf')
//   Rutas:    sce_asp/_lib/file/doc/pagos/{gen}/  →  sce/_lib/file/doc/pagos/{gen}/
// ---------------------------------------------------------------------------

if ([cont_file] != '' && {doc_compr_pago} != '') {

	error_log("form_pagos chg_filename: INICIO id_pago=".{id_pago}." doc_compr_pago=".{doc_compr_pago});

	// --- Datos del archivo y del registro (tabla pagos tiene id_asp_FK, no Id) ---
	$ext = substr({doc_compr_pago}, -3, 3);
	$id_asp = {id_asp_FK};

	// --- Obtener requisito de pago de la convocatoria activa ---
	// La consulta arroja: num_requisito (ej. 00000000008), prefijo_requisito (ej. comp_pago)
	// Tabla list_req_gral: atributo prefijo_requisito varchar(255), identifica el tipo de requisito en el nombre del archivo
	$qry_numreq = "SELECT list_req_gral.num_requisito, list_req_gral.prefijo_requisito FROM convocatorias_posg
		INNER JOIN list_req_gral
		ON convocatorias_posg.id_conv = list_req_gral.id_conv_FK
		WHERE cc_activa = 1 AND cc_pago = 1";
	sc_lookup(rs, $qry_numreq);
	$num_req = {rs[0][0]};
	$num_req_short = str_pad((string)(int)$num_req, 2, '0', STR_PAD_LEFT);
	if ($num_req_short === '') { $num_req_short = '00'; }
	$prefijo_req = trim({rs[0][1]});
	if ($prefijo_req == '') { $prefijo_req = 'pago'; }

	error_log("form_pagos chg_filename: num_req=".$num_req." prefijo_req=".$prefijo_req." ext=".$ext." id_asp=".$id_asp);

	// --- Rutas ---
	// $ruta_upload: carpeta del form_pagos en sce_asp (ScriptCase sirve la descarga desde aquí)
	// $ruta:        copia para proyecto sce (la usa grid_pagos_t)
	// $ruta2:       copia en carpeta del aspirante (sce_asp, por generacion/login)
	$ruta_upload = $_SERVER['DOCUMENT_ROOT'] . "/sce_asp/_lib/file/doc/pagos/".[generacion]."/";
	$ruta  = $_SERVER['DOCUMENT_ROOT'] . "/sce/_lib/file/doc/pagos/".[generacion]."/";
	$ruta2 = $_SERVER['DOCUMENT_ROOT'] . "/sce_asp/_lib/file/doc/aspirantes/".[generacion]."/".[usr_login]."/";

	// Asegurar que exista la carpeta destino en sce/
	if (!is_dir($ruta)) {
		@mkdir($ruta, 0755, true);
		error_log("form_pagos chg_filename: carpeta pagos sce creada " . $ruta);
	}

	// --- Nombres nuevos: en pagos (referencia_prefijo.ext); en aspirantes (generacion_id_asp_num_req_prefijo.ext) ---
	// num_req_short = número con mínimo 2 dígitos (ej. 08, 09, 10) para el nombre del archivo
	$nw_na = {referencia}."_".$prefijo_req.".".$ext;
	$nw_na2 = [generacion]."_".$id_asp."_".$num_req_short."_".$prefijo_req.".".$ext;
	$nom_original = $ruta_upload.{doc_compr_pago};
	$dest_form = $ruta_upload.$nw_na;
	$dest_sce  = $ruta.$nw_na;

	// --- Crear nombre estandarizado en sce_asp (lo necesita form_pagos_doc.php para descargar/visualizar) ---
	$ok_copy_form = @copy($nom_original, $dest_form);
	if (!$ok_copy_form) {
		error_log("form_pagos chg_filename: ERROR copy form origen=".$nom_original." destino=".$dest_form." existe_origen=".(file_exists($nom_original) ? 'si' : 'no'));
	} else {
		error_log("form_pagos chg_filename: copy form OK -> ".$dest_form);
	}

	// --- Copiar también a sce (la usa grid_pagos_t) ---
	$ok_copy_sce = @copy($dest_form, $dest_sce);
	if (!$ok_copy_sce) {
		error_log("form_pagos chg_filename: ERROR copy sce origen=".$dest_form." destino=".$dest_sce." existe_origen=".(file_exists($dest_form) ? 'si' : 'no'));
	} else {
		error_log("form_pagos chg_filename: copy sce OK -> ".$dest_sce);
	}

	// --- Asegurar carpeta de aspirantes (multiplataforma) y copiar archivo ahí ---
	// Windows: md existe, pero usar PHP evita dependencia del shell y rutas con espacios.
	// macOS/Linux: md NO existe (es comando de Windows); shell_exec('md') falla sin crear la carpeta.
	// Solución: mkdir() nativo de PHP con tercer parámetro true = recursivo (como mkdir -p en Unix).
	// Funciona igual en Windows, macOS y Linux.
	if (!is_dir($ruta2)) {
		$ok_dir = @mkdir($ruta2, 0755, true);
		if (!$ok_dir) { error_log("form_pagos chg_filename: ERROR no se pudo crear carpeta ".$ruta2); }
		else { error_log("form_pagos chg_filename: carpeta creada ".$ruta2); }
	}
	$origen = $dest_form;
	$destino = $ruta2.$nw_na2;
	error_log("form_pagos chg_filename: ruta_destino=".$ruta2." archivo_destino=".$nw_na2);
	$ok_copy = @copy($origen, $destino);
	if (!$ok_copy) {
		error_log("form_pagos chg_filename: ERROR copy falló origen=".$origen." destino=".$destino." existe_origen=".(file_exists($origen) ? 'si' : 'no')." existe_carpeta_dest=".(is_dir($ruta2) ? 'si' : 'no'));
	} else {
		error_log("form_pagos chg_filename: copy OK -> ".$nw_na2." en aspirantes");
	}

	// --- Limpiar el archivo original subido por el usuario ---
	// Solo se elimina si ya existe el renombrado en sce_asp, la copia en sce y la copia en aspirantes.
	if (basename($nom_original) !== $nw_na && file_exists($dest_form) && file_exists($dest_sce) && file_exists($destino)) {
		$ok_del = @unlink($nom_original);
		if (!$ok_del) {
			error_log("form_pagos chg_filename: WARN no se pudo eliminar original ".$nom_original);
		} else {
			error_log("form_pagos chg_filename: original eliminado ".basename($nom_original));
		}
	}

	// --- Actualizar nombre en tabla pagos (sce) ---
	$update_sql = "UPDATE sce.pagos SET doc_compr_pago='".$nw_na."' WHERE id_pago='".{id_pago}."'";
	sc_exec_sql($update_sql);
	{doc_compr_pago} = $nw_na;

	// --- Actualizar nombre en tabla asp_requisitos (sce_asp) ---
	$update_sql2 = "UPDATE sce_asp.asp_requisitos SET archivo='".$nw_na2."' WHERE login_FK='".[usr_login]."' AND num_req=".$num_req;
	sc_exec_sql($update_sql2);

	error_log("form_pagos chg_filename: FIN - pagos y asp_requisitos actualizados");
} else {
	error_log("form_pagos chg_filename: SKIP - cont_file o doc_compr_pago vacío");
}

// ============================================================================
// BLOQUE 2: CSF (Constancia de Situación Fiscal)
// ============================================================================
// Nombre en pagos:      {referencia}_csf.{ext}          ej. INECOLPA0002127600_csf.pdf
// Nombre en aspirantes: {generacion}_{id_asp}_{num_req}_csf.{ext}  ej. 2026_1276_09_csf.pdf
// Rutas:
//   upload (sce_asp):   sce_asp/_lib/file/doc/pagos/{generacion}/
//   copia sce:          sce/_lib/file/doc/pagos/{generacion}/
//   copia aspirantes:   sce_asp/_lib/file/doc/aspirantes/{generacion}/{usr_login}/
// num_req: se obtiene desde list_req_gral donde prefijo_requisito = 'csf'
// ============================================================================
if ({doc_csf} != '') {

	error_log("form_pagos chg_filename CSF: INICIO id_pago=".{id_pago}." doc_csf=".{doc_csf});

	// --- Datos del archivo ---
	$ext_csf   = substr({doc_csf}, -3, 3);
	$id_asp_csf = {id_asp_FK};

	// --- Obtener num_req del requisito CSF en la convocatoria activa ---
	$qry_csf_req = "SELECT list_req_gral.num_requisito FROM convocatorias_posg
		INNER JOIN list_req_gral ON convocatorias_posg.id_conv = list_req_gral.id_conv_FK
		WHERE cc_activa = 1 AND list_req_gral.prefijo_requisito = 'csf' LIMIT 1";
	sc_lookup(rs_csf, $qry_csf_req);
	$num_req_csf = isset({rs_csf[0][0]}) ? {rs_csf[0][0]} : '';
	$num_req_csf_short = ($num_req_csf !== '') ? str_pad((string)(int)$num_req_csf, 2, '0', STR_PAD_LEFT) : '00';

	error_log("form_pagos chg_filename CSF: num_req=".$num_req_csf." ext=".$ext_csf." id_asp=".$id_asp_csf);

	// --- Rutas ---
	$ruta_upload_csf = $_SERVER['DOCUMENT_ROOT'] . "/sce_asp/_lib/file/doc/pagos/".[generacion]."/";
	$ruta_sce_csf    = $_SERVER['DOCUMENT_ROOT'] . "/sce/_lib/file/doc/pagos/".[generacion]."/";
	$ruta_asp_csf    = $_SERVER['DOCUMENT_ROOT'] . "/sce_asp/_lib/file/doc/aspirantes/".[generacion]."/".[usr_login]."/";

	// Asegurar carpeta destino en sce/
	if (!is_dir($ruta_sce_csf)) {
		@mkdir($ruta_sce_csf, 0755, true);
		error_log("form_pagos chg_filename CSF: carpeta sce creada " . $ruta_sce_csf);
	}

	// Asegurar carpeta destino en aspirantes/
	if (!is_dir($ruta_asp_csf)) {
		$ok_dir_csf = @mkdir($ruta_asp_csf, 0755, true);
		if (!$ok_dir_csf) { error_log("form_pagos chg_filename CSF: ERROR no se pudo crear carpeta " . $ruta_asp_csf); }
		else              { error_log("form_pagos chg_filename CSF: carpeta aspirantes creada " . $ruta_asp_csf); }
	}

	// --- Nombres normalizados ---
	$nw_csf      = {referencia}."_csf.".$ext_csf;
	$nw_csf_asp  = [generacion]."_".$id_asp_csf."_".$num_req_csf_short."_csf.".$ext_csf;
	$orig_csf    = $ruta_upload_csf.{doc_csf};
	$dest_csf    = $ruta_upload_csf.$nw_csf;
	$dest_csf_sce = $ruta_sce_csf.$nw_csf;
	$dest_csf_asp = $ruta_asp_csf.$nw_csf_asp;

	error_log("form_pagos chg_filename CSF: orig=".$orig_csf." dest_form=".$dest_csf." dest_sce=".$dest_csf_sce." dest_asp=".$dest_csf_asp);

	// 1. Copiar con nombre normalizado en sce_asp (para descarga/visualización en form_pagos)
	$ok_csf_form = @copy($orig_csf, $dest_csf);
	if (!$ok_csf_form) {
		error_log("form_pagos chg_filename CSF: ERROR copy form origen=".$orig_csf." destino=".$dest_csf." existe_origen=".(file_exists($orig_csf) ? 'si' : 'no'));
	} else {
		error_log("form_pagos chg_filename CSF: copy form OK -> ".$dest_csf);
	}

	// 2. Copiar a sce/ (para grid_pagos y tesorería)
	$ok_csf_sce = @copy($dest_csf, $dest_csf_sce);
	if (!$ok_csf_sce) {
		error_log("form_pagos chg_filename CSF: ERROR copy sce origen=".$dest_csf." destino=".$dest_csf_sce." existe_origen=".(file_exists($dest_csf) ? 'si' : 'no'));
	} else {
		error_log("form_pagos chg_filename CSF: copy sce OK -> ".$dest_csf_sce);
	}

	// 3. Copiar a carpeta del aspirante en sce_asp/
	$ok_csf_asp = @copy($dest_csf, $dest_csf_asp);
	if (!$ok_csf_asp) {
		error_log("form_pagos chg_filename CSF: ERROR copy asp origen=".$dest_csf." destino=".$dest_csf_asp." existe_origen=".(file_exists($dest_csf) ? 'si' : 'no')." existe_carpeta=".(is_dir($ruta_asp_csf) ? 'si' : 'no'));
	} else {
		error_log("form_pagos chg_filename CSF: copy asp OK -> ".$nw_csf_asp);
	}

	// 4. Eliminar original solo si las tres copias existen
	if (basename($orig_csf) !== $nw_csf && file_exists($dest_csf) && file_exists($dest_csf_sce) && file_exists($dest_csf_asp)) {
		$ok_del_csf = @unlink($orig_csf);
		if (!$ok_del_csf) {
			error_log("form_pagos chg_filename CSF: WARN no se pudo eliminar original " . $orig_csf);
		} else {
			error_log("form_pagos chg_filename CSF: original eliminado " . basename($orig_csf));
		}
	}

	// 5. Actualizar doc_csf en sce.pagos
	$update_csf = "UPDATE sce.pagos SET doc_csf='".$nw_csf."' WHERE id_pago='".{id_pago}."'";
	sc_exec_sql($update_csf);
	{doc_csf} = $nw_csf;

	// 6. Actualizar asp_requisitos si se encontró num_req para CSF
	if ($num_req_csf !== '') {
		$update_csf2 = "UPDATE sce_asp.asp_requisitos SET archivo='".$nw_csf_asp."' WHERE login_FK='".[usr_login]."' AND num_req=".$num_req_csf;
		sc_exec_sql($update_csf2);
	}

	error_log("form_pagos chg_filename CSF: FIN - doc_csf y asp_requisitos actualizados");
} else {
	error_log("form_pagos chg_filename CSF: SKIP - doc_csf vacío");
}