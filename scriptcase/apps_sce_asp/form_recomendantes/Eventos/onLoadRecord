// Se ejecuta POR CADA FILA. Bloquea campos si cc_edit=0 + oculta botones borrar
// ====================================================================

$cc_edit_val = {cc_edit};
error_log("🔒 form_recomendantes onLoadRecord: id_recom={id_recom} cc_edit=$cc_edit_val");

if ($cc_edit_val == 0 || $cc_edit_val === '0') {
    error_log("🔒 form_recomendantes onLoadRecord: Bloqueando campos para id_recom={id_recom}");
    // sc_field_disabled_record bloquea campos POR FILA
    sc_field_disabled_record("nombre_=true;apellido_p_=true;apellido_m_=true;correo_=true");
}

// Mostrar num_recom según el vínculo del aspirante actual (num_req), no solo por recomendantes.num_recom.
// Esto evita duplicados visuales cuando un mismo recomendante se comparte entre aspirantes con distinto rol.
$id_recom_ctx = trim((string){id_recom});
$id_asp_ctx = isset([id_asp]) ? trim((string)[id_asp]) : '';
if ($id_recom_ctx !== '' && $id_asp_ctx !== '') {
    sc_lookup(
        rs_numreq_ctx,
        "SELECT num_req
         FROM asp_recomendantes
         WHERE id_asp_FK = " . sc_sql_injection($id_asp_ctx) . "
           AND id_recom_FK = " . sc_sql_injection($id_recom_ctx) . "
         ORDER BY id_asp_recom DESC
         LIMIT 1"
    );

    if (isset({rs_numreq_ctx[0][0]})) {
        $num_req_ctx = (int){rs_numreq_ctx[0][0]};
        $num_recom_ui = null;
        if ($num_req_ctx === 10) {
            $num_recom_ui = 1;
        } elseif ($num_req_ctx === 11) {
            $num_recom_ui = 2;
        } elseif ($num_req_ctx === 13) {
            $num_recom_ui = 3;
        }

        if ($num_recom_ui !== null) {
            {num_recom} = $num_recom_ui;
            error_log("🔢 form_recomendantes onLoadRecord: id_asp=$id_asp_ctx id_recom=$id_recom_ctx num_req=$num_req_ctx => num_recom_ui=$num_recom_ui");
        }
    }
}

// Inyectar JavaScript adicional para ocultar botones de borrar
?>
<script>
(function() {
    // Esperar a que cargue el DOM
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', ocultarBotonesDelete);
    } else {
        ocultarBotonesDelete();
    }
    
    function ocultarBotonesDelete() {
        // Buscar y ocultar TODOS los botones/iconos de delete
        const selectores = [
            'img[src*="delete"]',
            'img[src*="btdel"]',
            'img[src*="ico_delete"]',
            'img[title="Delete"]',
            'img[title="Borrar"]',
            'img[alt="Delete"]',
            'img[alt="Borrar"]',
            'a[onclick*="excluir"]',
            'button[name*="delete"]',
            '.scButton_delete'
        ];
        
        selectores.forEach(function(selector) {
            try {
                const elementos = document.querySelectorAll(selector);
                elementos.forEach(function(el) {
                    el.style.display = 'none';
                    el.style.visibility = 'hidden';
                    el.style.opacity = '0';
                    /* NO ocultar parentElement: el botón Guardar puede estar en la misma celda */
                });
            } catch(e) {
                console.warn('Error ocultando selector:', selector, e);
            }
        });
        
        console.log('🗑️ Botones de borrar ocultados via JavaScript');
    }
    
    // Ejecutar también tras un pequeño delay por si el DOM cambia
    setTimeout(ocultarBotonesDelete, 500);
    setTimeout(ocultarBotonesDelete, 1000);
})();
</script>
