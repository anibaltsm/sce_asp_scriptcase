// ---------------------------------------------------------------------------
// Evento: OnBeforeUpdate
// Crea las carpetas de cartas antes de que ScriptCase deposite el archivo subido.
//
// ScriptCase deposita el archivo en: cartas/[generacion]/[usr_login]/
// (subdirectorio del campo = cartas/[generacion]/[usr_login])
//
// Se crean ambas carpetas con permisos 0775 para que el usuario del servidor
// web (ej. daemon) pueda escribir en ellas.
// ---------------------------------------------------------------------------

$cartas      = $_SERVER['DOCUMENT_ROOT'] . "/sce_asp/_lib/file/doc/cartas/".[generacion]."/";
$cartas_usr  = $cartas . [usr_login] . "/";
if (!is_dir($cartas))     { @mkdir($cartas,     0775, true); }
if (!is_dir($cartas_usr)) { @mkdir($cartas_usr, 0775, true); }
