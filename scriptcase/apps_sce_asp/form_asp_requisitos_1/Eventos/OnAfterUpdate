// ---------------------------------------------------------------------------
// Evento: OnAfterUpdate
// Localiza el archivo subido, lo renombra con nomenclatura estándar y lo copia
// a la carpeta del aspirante. Actualiza asp_requisitos.archivo en BD.
//
// Rutas (usa DOCUMENT_ROOT):
//   ScriptCase deposita: cartas/[generacion]/[usr_login]/   ← usuario logueado
//   Destino renombrado : cartas/[generacion]/[correo_asp]/  ← login_FK del registro
//   Copia para descarga: cartas/[generacion]/[usr_login]/   ← copiado de vuelta
//   Copia de consulta  : aspirantes/[generacion]/[correo_asp]/
//
// {login_FK} = correo del aspirante al que pertenece el requisito.
// [usr_login] = usuario logueado (puede ser recomendante ≠ aspirante).
//
// Nombre final: generacion_id_asp_num_req_prefijo.ext  (ej. 2026_1281_11_carta_opinion.pdf)
// Logs: ver README_LOGS.md en la raíz del proyecto.
// ---------------------------------------------------------------------------

// PASO 1: Validar que hay archivo subido
if (empty({archivo})) {
	error_log("form_asp_requisitos_1 OnAfterUpdate: SKIP - campo archivo vacío");
	return;
}
$nombre_original = basename({archivo});
error_log("form_asp_requisitos_1 OnAfterUpdate: INICIO id_asp_req=".{id_asp_req}." archivo=".$nombre_original);

// PASO 2: Extensión del archivo
$ext = strtolower(pathinfo($nombre_original, PATHINFO_EXTENSION));
if ($ext === '') { $ext = 'pdf'; }

// PASO 3: Datos del registro
// id_asp_FK viene con zerofill → se limpia para el nombre (ej. 00000001281 → 1281)
$id_asp = (string)(int){id_asp_FK};
// num_req viene con zerofill → mínimo 2 dígitos (ej. 00000011 → 11)
$num_req_short = str_pad((string)(int){num_req}, 2, '0', STR_PAD_LEFT);
// login_FK del registro = correo del aspirante (NO [usr_login] que es el logueado)
$correo_asp = trim({login_FK});

// PASO 4: Prefijo del tipo de requisito (del campo del registro; si está vacío, desde sce.list_req_gral)
$prefijo_req = trim({prefijo_requisito});
if ($prefijo_req === '') {
	sc_lookup(rs_pref, "SELECT prefijo_requisito FROM sce.list_req_gral WHERE id_lisreq = ".{id_lisreq_FK});
	$prefijo_req = trim({rs_pref[0][0]});
}
error_log("form_asp_requisitos_1 OnAfterUpdate: id_asp=".$id_asp." num_req=".$num_req_short." prefijo=".$prefijo_req." correo_asp=".$correo_asp." ext=".$ext);

// PASO 5: Rutas
// ruta_cartas_plano : cartas/[generacion]/             → directorio base (depósito plano)
// ruta_cartas_usr   : cartas/[generacion]/[usr_login]/ → donde ScriptCase deposita el archivo
//                     cuando el subdirectorio del campo incluye [usr_login]
// ruta_cartas_asp   : cartas/[generacion]/[correo_asp]/ → destino final del archivo renombrado
// ruta_destino      : aspirantes/[generacion]/[correo_asp]/ → copia de consulta
$ruta_cartas_plano = $_SERVER['DOCUMENT_ROOT'] . "/sce_asp/_lib/file/doc/cartas/".[generacion]."/";
$ruta_cartas_usr   = $_SERVER['DOCUMENT_ROOT'] . "/sce_asp/_lib/file/doc/cartas/".[generacion]."/".[usr_login]."/";
$ruta_cartas_asp   = $_SERVER['DOCUMENT_ROOT'] . "/sce_asp/_lib/file/doc/cartas/".[generacion]."/".$correo_asp."/";
$ruta_destino      = $_SERVER['DOCUMENT_ROOT'] . "/sce_asp/_lib/file/doc/aspirantes/".[generacion]."/".$correo_asp."/";
error_log("form_asp_requisitos_1 OnAfterUpdate: ruta_cartas_plano=".$ruta_cartas_plano." ruta_cartas_usr=".$ruta_cartas_usr." ruta_cartas_asp=".$ruta_cartas_asp);

// PASO 6: Nombre final del archivo
// Formato: generacion_id_asp_num_req_prefijo.ext  (ej. 2026_1281_11_carta_opinion.pdf)
$nombre_pdf = [generacion]."_".$id_asp."_".$num_req_short."_".$prefijo_req.".".$ext;
error_log("form_asp_requisitos_1 OnAfterUpdate: nombre_pdf=".$nombre_pdf." destino=".$ruta_destino);

// PASO 6b: Skip si el archivo ya fue procesado en este mismo registro
// Sucede cuando el usuario guarda el formulario sin subir un archivo nuevo.
// El campo {archivo} ya contiene el nombre renombrado y el fichero está en su lugar.
if ({archivo} === $nombre_pdf && file_exists($ruta_cartas_asp . $nombre_pdf)) {
	error_log("form_asp_requisitos_1 OnAfterUpdate: SKIP - archivo ya procesado ".$nombre_pdf);
	return;
}

// PASO 7: Localizar el archivo subido.
// ScriptCase puede depositarlo en distintas rutas según la configuración del campo:
//   a) ruta_cartas_usr : cartas/[generacion]/[usr_login]/  (subdirectorio con login — caso habitual)
//   b) ruta_cartas_plano: cartas/[generacion]/              (sin subcarpeta)
// Se busca primero por nombre exacto en cada ruta y luego el archivo más reciente (< 90 s).
$archivo_origen = null;
for ($i = 0; $i < 3; $i++) {
	if ($i > 0) { sleep(1); }

	// 1. Nombre exacto en la subcarpeta del usuario logueado (ruta más frecuente)
	$candidato_usr = $ruta_cartas_usr . $nombre_original;
	if (file_exists($candidato_usr)) { $archivo_origen = $candidato_usr; break; }

	// 2. Nombre exacto en el directorio base plano
	$candidato = $ruta_cartas_plano . $nombre_original;
	if (file_exists($candidato)) { $archivo_origen = $candidato; break; }

	// 3. Nombre exacto en la subcarpeta del aspirante (por si ya fue movido parcialmente)
	$candidato_asp = $ruta_cartas_asp . $nombre_original;
	if (file_exists($candidato_asp)) { $archivo_origen = $candidato_asp; break; }

	// 4. Archivo más reciente (< 90 s) en cualquiera de los tres directorios
	$hace_90  = time() - 90;
	$reciente = null;
	$dirs_buscar = array_unique([$ruta_cartas_usr, $ruta_cartas_plano, $ruta_cartas_asp]);
	foreach ($dirs_buscar as $_dir) {
		if (!is_dir($_dir)) continue;
		foreach (new DirectoryIterator($_dir) as $f) {
			if ($f->isDot() || !$f->isFile() || strtolower($f->getExtension()) !== $ext) continue;
			if ($f->getMTime() < $hace_90) continue;
			if ($reciente === null || $f->getMTime() > $reciente['mtime']) {
				$reciente = array('path' => $f->getPathname(), 'mtime' => $f->getMTime());
			}
		}
	}
	if ($reciente !== null) { $archivo_origen = $reciente['path']; break; }
}

if ($archivo_origen === null || !file_exists($archivo_origen)) {
	error_log("form_asp_requisitos_1 OnAfterUpdate: ERROR no se encontró el archivo en ".$ruta_cartas_plano." buscado=".$nombre_original);
	sc_error_message("No se encontró el archivo subido en la carpeta de carga. Intenta de nuevo.");
	return;
}
error_log("form_asp_requisitos_1 OnAfterUpdate: archivo encontrado -> ".basename($archivo_origen));

// PASO 8: Copiar (NO renombrar) el archivo al nombre estandarizado en ruta_cartas_asp.
// Se usa copy() en lugar de rename() para que el archivo con nombre hasheado de ScriptCase
// (ej. archivo_abc123.pdf) permanezca en su ubicación original.
// ScriptCase genera la URL de descarga con ese hash ANTES de que OnAfterUpdate corra,
// por lo que si se renombra/mueve ese archivo la descarga inmediata falla con 404.
if (!is_dir($ruta_cartas_asp)) {
	$ok_cartas = @mkdir($ruta_cartas_asp, 0775, true);
	if (!$ok_cartas) { error_log("form_asp_requisitos_1 OnAfterUpdate: ERROR no se pudo crear carpeta ".$ruta_cartas_asp); }
	else             { error_log("form_asp_requisitos_1 OnAfterUpdate: carpeta cartas creada ".$ruta_cartas_asp); }
}
$archivo_renombrado = $ruta_cartas_asp . $nombre_pdf;
$ok_paso8 = @copy($archivo_origen, $archivo_renombrado);
if (!$ok_paso8) {
	error_log("form_asp_requisitos_1 OnAfterUpdate: ERROR copy PASO8 falló origen=".$archivo_origen." destino=".$archivo_renombrado);
	sc_error_message("No se pudo procesar el archivo subido. Intenta de nuevo.");
	return;
}
error_log("form_asp_requisitos_1 OnAfterUpdate: copy OK en cartas/".$correo_asp."/ -> ".$nombre_pdf);

// PASO 8b: Si el uploader es distinto al aspirante (ej. recomendante), copiar también
// el nombre estandarizado a ruta_cartas_usr. Así, cuando la página recarga y el link de
// descarga ya apunta al nombre estandarizado (de la BD actualizada), ScriptCase lo encuentra
// independientemente de quién esté logueado.
if (rtrim($ruta_cartas_usr, '/') !== rtrim($ruta_cartas_asp, '/')) {
	if (!is_dir($ruta_cartas_usr)) { @mkdir($ruta_cartas_usr, 0775, true); }
	$ok_usr_copy = @copy($archivo_renombrado, $ruta_cartas_usr . $nombre_pdf);
	if ($ok_usr_copy) {
		error_log("form_asp_requisitos_1 OnAfterUpdate: copia descarga usr -> ".$ruta_cartas_usr.$nombre_pdf);
	} else {
		error_log("form_asp_requisitos_1 OnAfterUpdate: WARN no se pudo copiar a ruta_cartas_usr -> ".$ruta_cartas_usr.$nombre_pdf);
	}
}

// PASO 8c: Borrar el archivo original (nombre del usuario o hash de ScriptCase) para no dejar residuos
// en la carpeta del usuario (ej. "power-skills (1).pdf"). La descarga usa ya el nombre estandarizado en BD.
if (file_exists($archivo_origen) && basename($archivo_origen) !== $nombre_pdf) {
	$ok_del = @unlink($archivo_origen);
	if ($ok_del) {
		error_log("form_asp_requisitos_1 OnAfterUpdate: residuo eliminado ".basename($archivo_origen));
	} else {
		error_log("form_asp_requisitos_1 OnAfterUpdate: WARN no se pudo eliminar residuo ".$archivo_origen);
	}
}

// PASO 9: Crear carpeta del aspirante en aspirantes/[generacion]/[correo_asp]/ si no existe
// La carpeta aspirantes/[generacion]/ debe ser escribible por el usuario del servidor web (ej. daemon).
// Si falla: chmod 0775 y chgrp daemon en aspirantes y en aspirantes/2026 (o el año correspondiente).
if (!is_dir($ruta_destino)) {
	$parent = $_SERVER['DOCUMENT_ROOT'] . "/sce_asp/_lib/file/doc/aspirantes/".[generacion];
	if (!is_dir($parent)) {
		@mkdir($parent, 0775, true);
	}
	$ok_dir = @mkdir($ruta_destino, 0775, true);
	if (!$ok_dir) {
		$err = error_get_last();
		$err_msg = ($err !== null && isset($err['message'])) ? $err['message'] : 'mkdir falló';
		error_log("form_asp_requisitos_1 OnAfterUpdate: ERROR no se pudo crear carpeta ".$ruta_destino." | ".$err_msg);
	} else {
		error_log("form_asp_requisitos_1 OnAfterUpdate: carpeta aspirantes creada ".$ruta_destino);
	}
}

// PASO 10: Copiar archivo a aspirantes/[generacion]/[correo_asp]/
$archivo_destino = $ruta_destino . $nombre_pdf;
$ok_copy = @copy($archivo_renombrado, $archivo_destino);
if (!$ok_copy) {
	error_log("form_asp_requisitos_1 OnAfterUpdate: ERROR copy falló origen=".$archivo_renombrado." destino=".$archivo_destino." existe_origen=".(file_exists($archivo_renombrado) ? 'si' : 'no')." existe_carpeta_dest=".(is_dir($ruta_destino) ? 'si' : 'no'));
	sc_error_message("No se pudo copiar el archivo a la carpeta del aspirante.");
	return;
}
error_log("form_asp_requisitos_1 OnAfterUpdate: copy OK -> ".$nombre_pdf." en aspirantes/".$correo_asp."/");

// PASO 11: Actualizar campo archivo en asp_requisitos con el nombre final.
// También se asigna {archivo} = $nombre_pdf para que ScriptCase use el nombre renombrado
// como valor del campo en memoria y no lo sobrescriba con el nombre original al refrescar.
sc_exec_sql("UPDATE sce_asp.asp_requisitos SET archivo='".addslashes($nombre_pdf)."' WHERE id_asp_req=".{id_asp_req});
{archivo} = $nombre_pdf;
error_log("form_asp_requisitos_1 OnAfterUpdate: FIN - asp_requisitos actualizado id_asp_req=".{id_asp_req}." archivo=".$nombre_pdf);

