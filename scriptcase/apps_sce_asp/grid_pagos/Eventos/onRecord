$formatos_pago_path = '/opt/lampp/htdocs/formatos-pago';

require_once $formatos_pago_path . '/config.local.php';
require_once $formatos_pago_path . '/lib/token.php';

$id_pago = intval({id_pago});
$token = generateDownloadToken($id_pago, 'r-pago');
$pdf_url = BASE_URL . '?type=r-pago&id=' . $id_pago . '&token=' . urlencode($token);

