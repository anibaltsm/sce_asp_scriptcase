{referencia} = htmlspecialchars($referencia_numero)
             . ' <a href="' . htmlspecialchars($pdf_url) . '" target="_blank" title="Formato de Pago Referenciado (PDF)" '
             . 'style="display: inline-block; margin-left: 8px; padding: 4px 10px; background: #0066cc; color: #fff; text-decoration: none; border-radius: 4px; font-size: 12px;">Descargar Formato</a>';