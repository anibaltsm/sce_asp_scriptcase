// CRÍTICO: Limpiar el WHERE si ya existe (para que se reconstruya con valor limpio)
if (isset($_SESSION['sc_session'][$this->sc_page]['grid_pagos']['where_orig'])) {
    // Si el WHERE tiene el valor con ceros, limpiarlo para que se reconstruya
    if (strpos($_SESSION['sc_session'][$this->sc_page]['grid_pagos']['where_orig'], '0000000') !== false) {
        unset($_SESSION['sc_session'][$this->sc_page]['grid_pagos']['where_orig']);
        unset($_SESSION['sc_session'][$this->sc_page]['grid_pagos']['where_pesq']);
        unset($_SESSION['sc_session'][$this->sc_page]['grid_pagos']['where_pesq_ant']);
        
        // Reconstruir el WHERE con el valor limpio
        $_SESSION['sc_session'][$this->sc_page]['grid_pagos']['where_orig'] = " where (id_asp_FK=" . $this->id_asp . ")";
        $_SESSION['sc_session'][$this->sc_page]['grid_pagos']['where_pesq'] = $_SESSION['sc_session'][$this->sc_page]['grid_pagos']['where_orig'];
        $_SESSION['sc_session'][$this->sc_page]['grid_pagos']['where_pesq_ant'] = $_SESSION['sc_session'][$this->sc_page]['grid_pagos']['where_orig'];
        
        error_log(" GRID_PAGOS: WHERE reconstruido con id_asp limpio = " . $this->id_asp);
