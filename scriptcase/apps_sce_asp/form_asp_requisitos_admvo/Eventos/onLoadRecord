// ------------------------------------------------------------------
// Referencia oficial Scriptcase v9 (eventos de form):
//   onLoad       : https://www.scriptcase.net/docs/en_us/v9/manual/06-applications/05-form-application/18-form-events/06-onLoad/
//   onLoadRecord : https://www.scriptcase.net/docs/en_us/v9/manual/06-applications/05-form-application/18-form-events/05-onLoadRecord/
//   onNavigate   : https://www.scriptcase.net/docs/en_us/v9/manual/06-applications/05-form-application/18-form-events/03-onNavigate/
//
// onLoadRecord es la FUENTE DE VERDAD del id_asp en este form
// multirregistro: onLoad global a veces recibe macros contaminadas por
// la sesión previa. Este evento calcula URL + id_asp correcto por fila
// y lo empuja al botón mediante scFormAdmvoVisorApply() o dejándolo en
// __scFormAdmvoVisorPending si aún no está definido.
//
// Los error_log() se conservan (silenciosos, útiles para diagnóstico
// en /opt/lampp/logs/php_error_log).
// ------------------------------------------------------------------

$__ajax_flag = isset($this->NM_ajax_flag) ? (bool)$this->NM_ajax_flag : false;
$__ajax_op   = isset($this->NM_ajax_opcao) ? $this->NM_ajax_opcao : '(none)';
$__has_ref   = isset($this->nmgp_refresh_fields) ? 'si' : 'no';
$__id_asp    = intval({id_asp_FK});
$__id_req    = intval({id_asp_req});
error_log(
    'VISOR onLoadRecord | ajax=' . ($__ajax_flag ? 'true' : 'false')
    . ' opcao=' . $__ajax_op
    . ' has_refresh_fields=' . $__has_ref
    . ' id_asp_FK=' . $__id_asp
    . ' id_asp_req=' . $__id_req
);

// Resolver id_asp con fallback
$__visor_id = $__id_asp;
if ($__visor_id <= 0 && $__id_req > 0) {
    sc_lookup(rs_vis_idasp_lr, 'SELECT id_asp_FK FROM asp_requisitos WHERE id_asp_req = ' . $__id_req . ' LIMIT 1');
    if (isset({rs_vis_idasp_lr[0][0]})) {
        $__visor_id = intval({rs_vis_idasp_lr[0][0]});
    }
    error_log('VISOR onLoadRecord fallback id_asp=' . $__visor_id);
}

// Ruta del visor
$__dirs = array(
    '/opt/lampp/htdocs/visor-requisitos-admvo',
    '/opt/sce_asp_scriptcase/visor-requisitos-admvo',
);
$__vpath = '';
foreach ($__dirs as $__d) {
    if (is_dir($__d) && is_file($__d . '/lib/token.php') && is_file($__d . '/config.php')) {
        $__vpath = $__d;
        break;
    }
}
error_log('VISOR onLoadRecord vpath=' . ($__vpath ?: 'NOT_FOUND') . ' id_asp=' . $__visor_id);

// Generar token y URL
$__vurl = '';
if ($__vpath !== '' && $__visor_id > 0) {
    require_once $__vpath . '/config.php';
    require_once $__vpath . '/lib/token.php';
    try {
        $__tok = generateDownloadToken($__visor_id, 'adm-visor-req');
    } catch (Throwable $e) {
        $__tok = '';
        error_log('VISOR onLoadRecord token ERROR: ' . $e->getMessage());
    }
    if ($__tok !== '') {
        $__base = rtrim(preg_replace(
            '#/(index|viewer|serve)\.php.*$#i', '',
            defined('VISOR_PUBLIC_BASE_URL') ? trim((string)VISOR_PUBLIC_BASE_URL) : 'https://posgrados.inecol.mx/visor-requisitos-admvo/'
        ), '/');
        $__vurl = $__base . '/index.php?type=adm-visor-req&id=' . $__visor_id . '&token=' . rawurlencode($__tok);
    }
}
error_log('VISOR onLoadRecord url=' . ($__vurl !== '' ? 'OK len=' . strlen($__vurl) : 'EMPTY'));

// Emitir JS para actualizar el botón en la página
$__jf  = JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT;
$__uj  = json_encode($__vurl, $__jf);
$__idj = json_encode($__visor_id, $__jf);
?>
<script type="text/javascript">
(function () {
    var u   = <?php echo $__uj; ?>;
    var idA = <?php echo $__idj; ?>;
    var fnSelf   = (typeof window.scFormAdmvoVisorApply === 'function');
    var fnParent = false;
    try { fnParent = (window.parent && typeof window.parent.scFormAdmvoVisorApply === 'function'); } catch (ePar) {}
    if (fnSelf) {
        window.scFormAdmvoVisorApply(u, idA);
    } else if (fnParent) {
        window.parent.scFormAdmvoVisorApply(u, idA);
    } else {
        var store = window;
        try { if (window.parent && window.parent !== window) { store = window.parent; } } catch (e2) {}
        store.__scFormAdmvoVisorPending = { url: u, idAsp: idA };
    }
})();
</script>
<?php
